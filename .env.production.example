# =========================================================
# .env.production — Production Configuration for Alibaba Cloud ECS
# Topshop Kosmetik AI
# =========================================================

# -------------------------------------------------------
# Informasi Aplikasi
# -------------------------------------------------------
APP_NAME="Topshop Kosmetik AI"
APP_ENV=production
APP_PORT=8000
DEBUG=false

# -------------------------------------------------------
# Database PostgreSQL + pgvector
# -------------------------------------------------------
POSTGRES_USER=topshop_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_DB=topshop_production_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# URL lengkap asyncpg untuk SQLAlchemy
DATABASE_URL=postgresql+asyncpg://topshop_admin:CHANGE_THIS_TO_STRONG_PASSWORD_MIN_32_CHARS@postgres:5432/topshop_production_db

# -------------------------------------------------------
# JWT Authentication & Security
# -------------------------------------------------------
# Generate dengan: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_HEX_64_CHARS_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------
# AI Provider — Alibaba Cloud Model Studio (Qwen)
# -------------------------------------------------------
AI_PROVIDER=alibaba
ALIBABA_CLOUD_API_KEY=YOUR_ALIBABA_CLOUD_DASHSCOPE_API_KEY
QWEN_MODEL=qwen-plus

# -------------------------------------------------------
# Google OAuth 2.0
# -------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# -------------------------------------------------------
# SMTP Email (OTP & Notifikasi)
# -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mail@topshopbeauty.cloud
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=mail@topshopbeauty.cloud
SMTP_FROM_NAME="Topshop Kosmetik"

# -------------------------------------------------------
# Payment Gateway — Mayar (Production)
# -------------------------------------------------------
MAYAR_API_KEY=YOUR_MAYAR_PRODUCTION_API_KEY
MAYAR_WEBHOOK_SECRET=YOUR_MAYAR_WEBHOOK_SIGNING_SECRET

# -------------------------------------------------------
# Shipping API — Biteship (Production)
# -------------------------------------------------------
BITESHIP_API_KEY=YOUR_BITESHIP_PRODUCTION_API_KEY

# -------------------------------------------------------
# Domain, Cloudflare & CORS
# -------------------------------------------------------
DOMAIN_NAME=topshopbeauty.cloud
FRONTEND_URL=https://topshopbeauty.cloud
ALLOWED_ORIGINS=https://topshopbeauty.cloud,https://www.topshopbeauty.cloud

