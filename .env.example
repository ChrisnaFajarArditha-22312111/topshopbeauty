# =========================================================
# .env.example — Template Environment Variable
# Topshop Kosmetik AI
# Salin file ini menjadi .env dan isi nilai yang sesuai
# JANGAN commit file .env ke repository!
# =========================================================

# -------------------------------------------------------
# Aplikasi
# -------------------------------------------------------
APP_NAME="Topshop Kosmetik AI"
APP_ENV=development
APP_PORT=8000

# -------------------------------------------------------
# Database PostgreSQL
# -------------------------------------------------------
POSTGRES_USER=topshop
POSTGRES_PASSWORD=topshop_secret
POSTGRES_DB=topshop_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# URL lengkap untuk SQLAlchemy (async)
DATABASE_URL=postgresql+asyncpg://topshop:topshop_secret@postgres:5432/topshop_db

# -------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------
# Gunakan: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------
# AI Provider
# Pilihan: alibaba | local
# -------------------------------------------------------
AI_PROVIDER=alibaba

# Alibaba Cloud Model Studio
ALIBABA_CLOUD_API_KEY=your_alibaba_cloud_api_key
QWEN_MODEL=qwen-plus

# -------------------------------------------------------
# Google OAuth
# -------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -------------------------------------------------------
# SMTP Email
# -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=mail@topshopbeauty.cloud
SMTP_FROM_NAME="Topshop Kosmetik"

# -------------------------------------------------------
# Payment Gateway — Mayar
# -------------------------------------------------------
MAYAR_API_KEY=your_mayar_api_key
MAYAR_WEBHOOK_SECRET=your_mayar_webhook_secret

# -------------------------------------------------------
# Shipping — Biteship
# -------------------------------------------------------
BITESHIP_API_KEY=your_biteship_api_key

# -------------------------------------------------------
# CORS (pisahkan dengan koma)
# -------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
