# Application
APP_NAME="Topshop Kosmetik AI"
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (local Docker defaults)
POSTGRES_USER=topshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=topshop_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://topshop:change-me@localhost:5432/topshop_db

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / Qwen
AI_PROVIDER=alibaba
ALIBABA_CLOUD_API_KEY=replace-with-your-alibaba-cloud-api-key
ALIBABA_CLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Topshop Kosmetik"

# Payment and shipping integrations
MAYAR_API_KEY=replace-with-your-mayar-api-key
MAYAR_WEBHOOK_SECRET=replace-with-your-mayar-webhook-secret
BITESHIP_API_KEY=replace-with-your-biteship-api-key
BITESHIP_WEBHOOK_SECRET=replace-with-your-biteship-webhook-secret
BITESHIP_WEBHOOK_HEADER=X-Webhook-Secret
